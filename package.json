{
	"name": "fractional-index-view",
	"version": "0.1.0",
	"description": "Bases view with drag-and-drop manual ordering backed by fractional index strings.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"test": "bun test --path-ignore-patterns \"zoxide-notes/**\" --path-ignore-patterns \"bases-manual-order/**\" --path-ignore-patterns \"NosyGrid/**\"",
		"release": "bun release.mjs",
		"lint": "eslint src tests release.mjs && stylelint styles.css"
	},
	"keywords": [
		"obsidian-plugin",
		"bases",
		"fractional-indexing"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@typescript-eslint/parser": "^8.60.0",
		"bun-types": "^1.3.14",
		"esbuild": "0.28.0",
		"eslint": "^10.4.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"stylelint": "^17.12.0",
		"stylelint-config-standard": "^40.0.0",
		"tslib": "2.8.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"fractional-indexing": "^4.0.0",
		"obsidian": "^1.14.4"
	}
}
